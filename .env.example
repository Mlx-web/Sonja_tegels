# Kopieer dit bestand naar ".env" en pas de waarden aan.

# Wachtwoord waarmee de beheerder inlogt.
ADMIN_PASSWORD=sonja123

# Geheime sleutel voor het ondertekenen van de sessie-cookie.
# Vul hier een willekeurige, lange reeks tekens in.
SESSION_SECRET=verander-deze-geheime-sleutel

# Poort waarop de server lokaal draait.
PORT=3000

# Sanity-project (CMS). Leeg laten om lokaal te testen met de voorbeeldtekst
# uit sanity/seed-data/ in plaats van een echt Sanity-project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
