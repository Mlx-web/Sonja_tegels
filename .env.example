# Kopieer dit bestand naar ".env" en pas de waarden aan.

# Wachtwoord waarmee de beheerder inlogt.
ADMIN_PASSWORD=sonja123

# Geheime sleutel voor het ondertekenen van de sessie-cookie.
# Vul hier een willekeurige, lange reeks tekens in.
SESSION_SECRET=verander-deze-geheime-sleutel

# Poort waarop de server lokaal draait.
PORT=3000

# Sanity-project (CMS). Leeg laten om lokaal te testen met de voorbeeldtekst
# uit sanity/seed-data/ in plaats van een echt Sanity-project.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Netlify-toegangstoken (persoonlijk access token, aan te maken via
# Netlify > User settings > Applications > New access token). Nodig om
# binnengekomen contactformulier-berichten (Netlify Forms) op te halen
# voor de berichtenpagina. Leeg laten om lokaal met een leeg berichtenlijstje
# te testen in plaats van echte Netlify-gegevens.
NETLIFY_API_TOKEN=

# Site-ID van het Netlify-project (te vinden bij Site configuration >
# General > Site details). Hoeft niet ingevuld te worden wanneer de code
# als Netlify Function draait: dan wordt dit automatisch door Netlify
# zelf meegegeven.
NETLIFY_SITE_ID=
